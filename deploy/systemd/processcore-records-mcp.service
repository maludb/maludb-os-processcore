# /etc/systemd/system/processcore-records-mcp.service
# The records-memory MCP server (processcore_records_mcp) on 127.0.0.1 port 8701. Read-only.
# Exposed by Apache at /mcp/records (deploy/apache/processcore-services.conf) behind bearer
# tokens issued on the AI access tokens screen (scope 'records').
[Unit]
Description=ProcessCore records-memory MCP server (processcore_records_mcp, port 8701)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=maludb
WorkingDirectory=/var/www/services
EnvironmentFile=-/var/www/config/services.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/services/.venv/bin/python -m records_mcp.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
