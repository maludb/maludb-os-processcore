# config/.env — what the Business OS kernel's installer (bin/app_install.php) writes when ProcessCore is installed
# beside a kernel; gitignored. Every key overrides config/application.php (see $envMap there); the standalone
# product uses config/local.php and config/services.env instead and needs none of this.
APP_NAME=ProcessCore
APP_URL=https://processcore.example.com
APP_KEY=processcore
APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=example_processcore
DB_USER=processcore_app
DB_PASSWORD=
MCP_RECORDS_DB_USER=processcore_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=processcore_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
APP_INTERNAL_PORT=8189
MCP_RECORDS_PORT=8839
MCP_ACTIVITY_PORT=8840
# The tenant's keys (copied from the kernel's config/.env by the installer — never by hand)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_ENABLED=1
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
