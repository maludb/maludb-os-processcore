# Template for config/services.env (gitignored). Copy, fill in, then chmod 0600.
# Read by services/common/config.py, deploy/activity-ingest.sh and the systemd units
# (EnvironmentFile). Real environment variables override these values.

# Database (same cluster and database as config/local.php)
PROCESSCORE_DB_HOST=127.0.0.1
PROCESSCORE_DB_PORT=5432
PROCESSCORE_DB_NAME=processcore_dev
PROCESSCORE_APP_DB_USER=processcore_app
PROCESSCORE_APP_DB_PASSWORD=
PROCESSCORE_RECORDS_DB_USER=processcore_records_ro
PROCESSCORE_RECORDS_DB_PASSWORD=
PROCESSCORE_ACTIVITY_DB_USER=processcore_activity_ro
PROCESSCORE_ACTIVITY_DB_PASSWORD=

# HMAC key shared with PHP: must equal security.action_token_key in config/local.php
PROCESSCORE_ACTION_TOKEN_KEY=

# Bearer tokens the assistant uses on the two read-only MCP servers. Generate with
# openssl rand -hex 32 and register their sha256 hashes in app.mcp_access_tokens
# (README, "Register the assistant's own MCP tokens").
PROCESSCORE_SERVICE_RECORDS_TOKEN=
PROCESSCORE_SERVICE_ACTIVITY_TOKEN=

# Public URL of the PHP app (same as app.base_url) and the local service ports
PROCESSCORE_APP_BASE_URL=https://processcore.example.com
PROCESSCORE_RECORDS_MCP_PORT=8701
PROCESSCORE_ACTIVITY_MCP_PORT=8702
PROCESSCORE_ACTIONS_MCP_PORT=8703
PROCESSCORE_ASSISTANT_PORT=8765

# Models for Ask-me-anything answers and command-bar routing
PROCESSCORE_AMA_MODEL=claude-opus-5-5
PROCESSCORE_ROUTER_MODEL=claude-opus-5-5
PROCESSCORE_ROUTER_EFFORT=low

# Anthropic credential for the assistant (an sk-ant-api... key, or an sk-ant-oat... OAuth token).
# Without it the services start and the assistant replies "not configured yet".
ANTHROPIC_API_KEY=
